# JWT
JWT_SECRET=                 # Clave secreta para firmar los tokens JWT (mínimo 32 caracteres)
JWT_EXPIRATION_MS=          # Tiempo de vida del token en milisegundos (p. ej. 86400000 = 24 h)

# Spring — conexión a base de datos
DB_USERNAME=                # Mismo valor que MARIADB_USER
DB_PASSWORD=                # Mismo valor que MARIADB_PASSWORD

# Docker Compose — MariaDB
MARIADB_ROOT_PASSWORD=      # Contraseña root de MariaDB
MARIADB_DATABASE=citaria
MARIADB_USER=
MARIADB_PASSWORD=

# Gemini
GEMINI_API_KEY=             # Clave de la API de Google Gemini (chatbot)
GEMINI_API_URL=             # URL del endpoint de Gemini

# Cloudinary (subida de imágenes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
